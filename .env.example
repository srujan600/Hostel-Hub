# ==============================================================================
# HostelHub - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Primary Database (MongoDB via Mongoose)
# ------------------------------------------------------------------------------
# Local Standalone Instance:
MONGODB_URI="mongodb://127.0.0.1:27017/hostelhub"

# MongoDB Atlas / Replica Set Example:
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hostelhub?retryWrites=true&w=majority"

# Optional Connection Tuning
MONGODB_DB_NAME="hostelhub"
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=45000

# ------------------------------------------------------------------------------
# Legacy Database (Source SQLite for Migration)
# Kept read-only for scripts/migrate-sqlite-to-mongo.ts data extraction
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# JWT Authentication Secrets
# ------------------------------------------------------------------------------
JWT_SECRET="hostelhub-super-secure-production-jwt-secret-key-32-chars-min"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# Application Runtime Settings
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
NEXT_PUBLIC_APP_NAME="HostelHub"
NEXT_PUBLIC_CAMPUS_NAME="North Campus Central"
